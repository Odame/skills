{
  "description": "Checks newly written or edited text against the plain-english banned-word list, word-frequency scoring, sentence readability, and the bundled idiom list, and seeds the wordlist and config on session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}\" plainspeak check",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}\" plainspeak seed",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
